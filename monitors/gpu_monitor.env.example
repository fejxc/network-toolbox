# GPU 平台监控配置示例（也可全部用命令行参数覆盖）
# Token 建议存 ~/.config/gpu-monitor/token（chmod 600），不要写进仓库：
#   mkdir -p ~/.config/gpu-monitor && umask 077
#   printf '%s' '粘贴浏览器里复制的 Bearer Token' > ~/.config/gpu-monitor/token

# 平台地址
GPU_PLATFORM_URL=http://10.11.154.209:16888

# 服务器 endpoint id（URL 里 /server/standalone/116 的 116）
GPU_PLATFORM_ENDPOINT_ID=116

# 平台 JWT；过期后（Payload 里 exp 字段）需重新登录导出
# GPU_PLATFORM_TOKEN=替换为新token
