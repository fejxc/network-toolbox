# 浙江图书馆 Wi-Fi 认证配置示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 也可直接用同名环境变量覆盖，或用 --username / --password 等命令行参数传入

# 用户名（读者证号 / 身份证号，视图书馆要求而定）
ZJLIB_WIFI_USERNAME=your_username

# 密码
ZJLIB_WIFI_PASSWORD=your_password

# 认证入口地址。门户只在「未认证」状态下伺服此页，已联网访问会返回 404（属正常现象）
ZJLIB_WIFI_URL=https://2.2.1.1:8443/cn/index.html

# 可选：请求超时秒数（默认 10）
# ZJLIB_WIFI_TIMEOUT=10
