# 浙江理工大学校园网 ePortal 配置示例
# 复制为 .env.zstu 后填写：
#   cp zstu/mac/env.example .env.zstu
#   chmod 600 .env.zstu

ZSTU_WIFI_USERNAME=your_username
ZSTU_WIFI_PASSWORD=your_password

# 推荐填写当前未认证时浏览器地址栏中的完整 URL；其中的查询参数会变化。
# 不填时脚本会尝试访问 connectivity check URL 触发门户跳转。
# ZSTU_WIFI_URL=http://192.168.102.130/eportal/index.jsp?...当前查询参数...

# 当前门户通常不需要选择服务；如果门户要求，可填实际 serviceName。
# ZSTU_WIFI_SERVICE=

# 可选
# ZSTU_WIFI_TIMEOUT=10
# ZSTU_WIFI_DISCOVERY_URL=http://connectivitycheck.gstatic.com/generate_204
