# Optional shell configuration for mdpi_monitor.py.
# Keep the real Cookie in ~/.config/mdpi-monitor/cookie or MDPI_COOKIE;
# do not commit it to this repository.
MDPI_URL=https://susy.mdpi.com/user/manuscripts/status
MDPI_INTERVAL=300
MDPI_NOTIFY=dingtalk
MDPI_DINGTALK_KEYWORD=MDPI
# Put the real URL in your local environment only; do not commit it.
# MDPI_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME
# MDPI_COOKIE_FILE=/Users/your-name/.config/mdpi-monitor/cookie
# MDPI_STATE_FILE=/Users/your-name/.cache/mdpi-monitor/state.json
